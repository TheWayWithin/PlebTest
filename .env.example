# PlebTest Environment Variables
# Copy this file to .env.local for local development
# All variables must also be set in Railway for staging and production

# =============================================================================
# SUPABASE (Required - Phase 0)
# =============================================================================
# Get from: https://supabase.com/dashboard/project/[project-id]/settings/api

# Public URL (safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon/Public key (safe for client-side, respects RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role key (server-only, bypasses RLS - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# POSTHOG ANALYTICS (Required - Phase 0)
# =============================================================================
# Get from: https://us.posthog.com/settings/project

NEXT_PUBLIC_POSTHOG_KEY=phc_your-project-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# =============================================================================
# APP CONFIGURATION (Required)
# =============================================================================

# Production: https://plebtest.com
# Staging: https://plebteststaging-staging.up.railway.app
# Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# OPENROUTER - AI/LLM (Required - Phase 1)
# =============================================================================
# Get from: https://openrouter.ai/keys

OPENROUTER_API_KEY=your-openrouter-api-key

# =============================================================================
# STRIPE - Payments (Required - Phase 1)
# =============================================================================
# Get from: https://dashboard.stripe.com/apikeys

# Publishable key (safe for client-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Secret key (server-only)
STRIPE_SECRET_KEY=sk_test_xxx

# Webhook secret (from Stripe webhook endpoint configuration)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# =============================================================================
# UPSTASH REDIS - Rate Limiting (Required - Phase 1)
# =============================================================================
# Get from: https://console.upstash.com/ (create Redis database)

UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# =============================================================================
# RESEND - Email (Required - Phase 1)
# =============================================================================
# Get from: https://resend.com/api-keys

RESEND_API_KEY=re_xxx

# =============================================================================
# DATABASE URL - pg-boss (Required - Phase 1.7 Background Jobs)
# =============================================================================
# Get from Supabase: Project Settings > Database > Connection string (URI)
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

DATABASE_URL=postgresql://postgres:xxx@db.xxx.supabase.co:5432/postgres

# =============================================================================
# SENTRY - Error Monitoring (Optional - Recommended for Production)
# =============================================================================
# Get from: https://sentry.io/settings/[org]/projects/[project]/keys/

NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
